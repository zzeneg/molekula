powershell "gci -filter *.stl | %% { $n=$_.Name -replace '^case-3part v\d+_',''; if($n -ne $_.Name){ ren $_.Name $n } }"
powershell "gci -filter *_topType_1.stl | %% { $n=$_.Name -replace '_topType_1\.stl$','.stl'; ni -ItemType Directory -Force -Path 'LP' | Out-Null; move $_.Name ('LP\'+$n) -Force }"
